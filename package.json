{
  "name": "helios-solar-explorer",
  "version": "1.1.0",
  "description": "A spatial-first 3D Solar System and nearby-star explorer with scientific provenance.",
  "license": "MIT",
  "author": "Chase Wilcox",
  "repository": {
    "type": "git",
    "url": "https://github.com/10th-Dimension/helios-solar-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/10th-Dimension/helios-solar-explorer/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:stellar": "node --experimental-strip-types scripts/verify-stellar-data.mjs",
    "test:aurora": "node --experimental-strip-types scripts/verify-aurora.mjs",
    "test:wheel": "node --experimental-strip-types scripts/verify-smooth-wheel.mjs",
    "test:solar": "node --experimental-strip-types scripts/verify-solar.mjs",
    "test": "npm run test:stellar && npm run test:aurora && npm run test:wheel && npm run test:solar && npm run test:science && npm run test:education",
    "typecheck": "tsc --noEmit --incremental false",
    "audit:public": "node scripts/audit-public-release.mjs",
    "test:science": "node --experimental-strip-types scripts/verify-science.mjs",
    "test:education": "node --experimental-strip-types scripts/verify-education.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "vinext": {
      "satori": {
        "fflate": "0.7.5"
      }
    }
  }
}
