{
  "name": "helios-solar-explorer",
  "version": "1.0.0",
  "description": "A spatial-first 3D Solar System and nearby-star explorer with scientific provenance.",
  "license": "MIT",
  "author": "Chase Wilcox",
  "repository": { "type": "git", "url": "https://github.com/10th-Dimension/helios-solar-explorer.git" },
  "bugs": { "url": "https://github.com/10th-Dimension/helios-solar-explorer/issues" },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:stellar": "node --experimental-strip-types scripts/verify-stellar-data.mjs",
    "test:aurora": "node --experimental-strip-types scripts/verify-aurora.mjs",
    "test:wheel": "node --experimental-strip-types scripts/verify-smooth-wheel.mjs",
    "test": "npm run test:stellar && npm run test:aurora && npm run test:wheel",
    "typecheck": "tsc --noEmit --incremental false",
    "audit:public": "node scripts/audit-public-release.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.3.5"
  },
  "type": "module"
}
