{
  "name": "helios-solar-explorer",
  "version": "1.1.2",
  "description": "A spatial-first 3D Solar System and nearby-star explorer with scientific provenance.",
  "license": "MIT",
  "author": "10th-Dimension",
  "repository": {
    "type": "git",
    "url": "https://github.com/10th-Dimension/helios-solar-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/10th-Dimension/helios-solar-explorer/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:stellar": "node --experimental-strip-types scripts/verify-stellar-data.mjs",
    "test:aurora": "node --experimental-strip-types scripts/verify-aurora.mjs",
    "test:wheel": "node --experimental-strip-types scripts/verify-smooth-wheel.mjs",
    "test:solar": "node --experimental-strip-types scripts/verify-solar.mjs",
    "test": "npm run test:stellar && npm run test:aurora && npm run test:wheel && npm run test:solar && npm run test:science && npm run test:education && npm run test:interior && npm run test:interaction && npm run test:roadmap && npm run test:catalog && npm run test:approach && npm run test:widgets && npm run test:no3d",
    "typecheck": "tsc --noEmit --incremental false",
    "audit:public": "node scripts/audit-public-release.mjs",
    "test:science": "node --experimental-strip-types scripts/verify-science.mjs",
    "test:education": "node --experimental-strip-types scripts/verify-education.mjs",
    "test:interior": "node --experimental-strip-types scripts/verify-interior-leader.mjs",
    "test:interaction": "node --experimental-strip-types scripts/verify-interaction-state.mjs",
    "test:browser": "playwright test",
    "format:check": "prettier --check app/page.tsx app/EducationPanel.tsx app/SolarSystemScene.tsx app/layout.tsx playwright.config.ts tests/browser/*.ts",
    "test:roadmap": "node --experimental-strip-types scripts/verify-roadmap.mjs",
    "test:catalog": "node --experimental-strip-types scripts/verify-catalog-navigation.mjs",
    "test:approach": "node --experimental-strip-types scripts/verify-approach-controls.mjs",
    "test:widgets": "node --experimental-strip-types scripts/verify-ui-widgets.mjs",
    "test:no3d": "node --experimental-strip-types scripts/verify-no3d-ui.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vinext": "1.4.5",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "satori@0.33.5": {
      "fflate": "0.7.5"
    }
  }
}
